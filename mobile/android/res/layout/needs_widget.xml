<?xml version="1.0" encoding="utf-8"?>
<!-- The "What needs you" widget (NeedsWidget.java). Three fixed rows that are shown or hidden: a
     RemoteViews list adapter would be a lot of machinery for a glance at three chats.
     The texts here are what the widget picker's preview shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_notify"
            android:tint="@color/widget_gold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nothing needs you"
            android:textColor="@color/widget_gold"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="2dp"
        android:text="Not connected — open the app"
        android:textColor="@color/widget_dim"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="2dp"
        android:text="Chats waiting for your OK show up here."
        android:textColor="@color/widget_dim"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Row 1: the newest, with Allow and Deny when it's a yes/no. -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/row1_title"
                style="@style/WidgetRowTitle" />
            <TextView
                android:id="@+id/row1_body"
                style="@style/WidgetRowBody" />
        </LinearLayout>
        <TextView
            android:id="@+id/row1_allow"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/widget_allow"
            android:text="Allow"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/row1_deny"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/widget_deny"
            android:text="Deny"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        style="@style/WidgetRow">
        <TextView
            android:id="@+id/row2_title"
            style="@style/WidgetRowTitle" />
        <TextView
            android:id="@+id/row2_body"
            style="@style/WidgetRowBody" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        style="@style/WidgetRow">
        <TextView
            android:id="@+id/row3_title"
            style="@style/WidgetRowTitle" />
        <TextView
            android:id="@+id/row3_body"
            style="@style/WidgetRowBody" />
    </LinearLayout>
</LinearLayout>
