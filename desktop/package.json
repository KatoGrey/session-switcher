{
  "name": "session-switcher",
  "productName": "Session Switcher",
  "version": "6.3.0",
  "description": "Every Claude Code and Codex chat on this computer, in one place, as whichever account you choose.",
  "author": "KatoGrey",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.katogrey.sessionswitcher",
    "productName": "Session Switcher",
    "artifactName": "SessionSwitcher-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "shell/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "app-files",
        "filter": [
          "server.js",
          "index.html",
          "theme.js",
          "styles.css",
          "sw.js",
          "package.json",
          "icon.ico",
          "crest.webp",
          "lib/**",
          "ui/**",
          "fonts/**",
          "sounds/**",
          "docs/whats-new.md",
          "art/**",
          "!art/src/**",
          "tests/**",
          "macos/icon.icns"
        ]
      },
      {
        "from": "phone",
        "to": "app-files",
        "filter": [
          "SessionSwitcher.apk",
          "SessionSwitcher.apk.json"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KatoGrey",
        "repo": "session-switcher",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Session Switcher",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "../macos/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "generateUpdatesFilesForAllChannels": true
  }
}
